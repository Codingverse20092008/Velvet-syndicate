# ==========================================
# Database (Turso/libSQL)
# ==========================================
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# ==========================================
# Redis (Upstash)
# ==========================================
REDIS_URL=https://your-redis.upstash.io
REDIS_TOKEN=your-redis-token

# Optional: Separate Redis for job queue
QUEUE_REDIS_URL=https://your-queue-redis.upstash.io
QUEUE_REDIS_TOKEN=your-queue-redis-token

# ==========================================
# Authentication (JWT)
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ==========================================
# App Configuration
# ==========================================
NODE_ENV=development
APP_URL=http://localhost:3000
API_VERSION=v1

# ==========================================
# Rate Limiting
# ==========================================
# Default limits
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# Auth endpoints (stricter)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=60

# Product endpoints (relaxed)
RATE_LIMIT_PRODUCTS_MAX=200
RATE_LIMIT_PRODUCTS_WINDOW=60

# ==========================================
# Monitoring (Sentry) - Optional
# ==========================================
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ENVIRONMENT=development

# ==========================================
# Email (Resend) - Optional
# ==========================================
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=noreply@velvetsyndicate.com

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=info
ENABLE_QUERY_LOGGING=false